{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // All keys and defaults: `cmux config docs`. Validate with `cmux config doctor`.

  "app": {
    "globalFontMagnification": 120
  },

  "shortcuts": {
    "bindings": {
      "focusDown": "cmd+opt+j",
      "focusLeft": "cmd+opt+h",
      "focusRight": "cmd+opt+l",
      "focusUp": "cmd+opt+k"
    }
  }
}
