# Brewfile — everything installable on this Mac, grouped by purpose.
#
#   brew bundle install --file=mac/Brewfile   # install anything missing
#   brew bundle check   --file=mac/Brewfile --verbose
#   brew bundle cleanup --file=mac/Brewfile   # list installed things not in here
#
# Only packages installed on purpose are listed; their dependencies are left
# to Homebrew so removing a tool also lets its libraries go.
# Apps that Homebrew can't install are listed at the bottom.

