# Generated by Gemini

# --- Settings ---
set icons true
set number
set relativenumber
set shell fish
set promptfmt "\033[34;1m%d\033[0m\033[1m%f\033[0m"
set editor nvim


# --- Open command ---
# Override lf's default "system opener" (which was routing files to
# Antigravity via macOS LaunchServices). Text-like files now open in
# $EDITOR (nvim); binaries/media still use the macOS `open`.
# Note: lf only runs `open` on FILES -- directories are still entered by
# `l`/<enter>, and the nvim floating-lf integration (-selection-path) is
# unaffected because it quits+writes the selection instead of running this.
cmd open ${{
    switch (file --mime-type -bL $f)
        case 'text/*' 'application/json' 'application/javascript' 'application/xml' 'application/x-shellscript' 'inode/x-empty'
            $EDITOR $f
        case '*'
            open $f
    end
}}

# --- Mappings ---
# Toggle hidden files
map . set hidden!

# Delete file kep map x instead of having to type delete

map x delete 

# Quit on enter to change directory in the shell
map <enter> quit
# Open under cursor: dir -> enter, file -> $EDITOR (see `cmd open` above)
map l open
# Edit current file in nvim
map e $nvim $f
# Edit selection (or current file) in nvim explicitly
map E $$EDITOR $fx
