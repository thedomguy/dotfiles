.DS_Store

# --- Intentionally NOT managed by this repo ---
# These symlinks exist locally (pointing to ~/.config/<name>) so
# manage_symlinks.sh's history stays legible, but their targets are
# either secrets or pure regenerable cache/state, so their content is
# never migrated into git. See README for the full explanation.

# Plaintext GitLab access token + oauth2 refresh token live in config.yml
glab-cli

# oauth.json / auth.db hold GitHub Copilot session credentials
github-copilot

# config.json contains a live Raycast API token; also ~100MB of
# extension/AI cache
raycast

# Personal notes database (database.sqlite) + ipc_secret_key.txt
joplin-desktop

# coc.nvim extension installs + cache, regenerated on demand (~35MB)
coc

# npm/yarn update-notifier timestamps, no dotfile value
configstore
simple-update-notifier

# --- Partial excludes within migrated dirs ---
# Regenerable plugin installs, not hand-authored config
nvim/pack/

# fish's universal-variable temp/state files (machine-specific runtime
# state, not portable config); fish_variables* covers both the live
# file and abandoned atomic-write temp files
fish/fish_variables*

# Jarvis voice conversation transcripts (personal history, not config)
jarvis-voice/conversations/
