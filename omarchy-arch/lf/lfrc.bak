set icons
set number
set relativenumber
set shell fish
set promptfmt "\033[34;1m%d\033[0m\033[1m%f\033[0m"

map . set hidden!

# Define a command to handle both directories and files
cmd open ${{
    case $(file --mime-type "$f" -b) in
        # For directories
        inode/directory)
            cd "$f" || return
            ;;
        # For text files
        text/*) 
            $EDITOR "$f"
            ;;
        # For all other files, use the default program
        *)
            for f in $fx; do
                $OPENER "$f" > /dev/null 2> /dev/null &
            done
            ;;
    esac
}}

# Map the enter key to use the open command
map <enter> open
map e vim "$f"
